{
  "rewrites": [
    {
      "source": "/coperta-squalo",
      "destination": "/coperta-squalo.html"
    },
    {
      "source": "/pigiama-anatra",
      "destination": "/pigiama-anatra.html"
    },
    {
      "source": "/pigiama-stranger-things",
      "destination": "/pigiama-stranger-things.html"
    },
    {
      "source": "/pigiama-stitch",
      "destination": "/pigiama-stitch.html"
    },
    {
      "source": "/pigiama-barbie-luminoso",
      "destination": "/pigiama-barbie-luminoso.html"
    },
    {
      "source": "/pigiama-dragon-trainer",
      "destination": "/pigiama-dragon-trainer.html"
    },
    {
      "source": "/centrale",
      "destination": "/centrale.html"
    }
  ],
  "headers": [
    {
      "source": "/ct.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=600"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/centrale(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
